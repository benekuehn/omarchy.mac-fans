#!/bin/bash
set -euo pipefail

[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 1; }
case ${1:-} in
  default) low=55 high=75 full=false ;;
  balanced) low=35 high=75 full=false ;;
  full) low=55 high=75 full=true ;;
  *) echo "usage: $0 {default|balanced|full}" >&2; exit 64 ;;
esac

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
mapfile -t fans < <(find /sys/devices -type f -path '*/APP0001:00/fan*_input' -print 2>/dev/null | sort -V)
((${#fans[@]})) || { echo "no Apple SMC fans found" >&2; exit 1; }
for input in "${fans[@]}"; do
  fan=${input##*/fan}; fan=${fan%_input}
  printf '[Fan%s]\nlow_temp=%s\nhigh_temp=%s\nspeed_curve=linear\nalways_full_speed=%s\n\n' "$fan" "$low" "$high" "$full" >>"$tmp"
done
install -m 644 "$tmp" /etc/t2fand.conf
systemctl restart t2fanrd.service
